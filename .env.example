
SERVER_PORT=8080

# Recommended: 2–8 dev, scale with CPU cores in prod. Range: 1–64
WORKER_COUNT=4
# Fallback interval when no Notify signal arrives. Range: 10–10000

WORKER_TICK_MS=50

# Reaper resets claims older than this to Waiting. Must exceed match formation time. Range: 100–30000
STALE_CLAIM_TIMEOUT_MS=500



RELAXATION_STAGE_1_MS=5000

# Stage 2: Short wait — slight quality relaxation.
RELAXATION_STAGE_2_MS=15000

# Stage 3: Medium wait — quality sacrificed for timeliness.
RELAXATION_STAGE_3_MS=30000

# Stage 4: Long wait — latency objective dominates quality objective.
RELAXATION_STAGE_4_MS=60000


RELAXATION_STAGE_1_DELTA=50

# Stage 2 (STAGE_1 – STAGE_2):  slightly wider
RELAXATION_STAGE_2_DELTA=100

# Stage 3 (STAGE_2 – STAGE_3):  noticeably wider
RELAXATION_STAGE_3_DELTA=200

# Stage 4 (STAGE_3 – STAGE_4):  wide — latency over quality
RELAXATION_STAGE_4_DELTA=400

# Stage 5 (STAGE_4+):           unconstrained — starvation prevention floor
# Set high enough to cover the full skill range (0–3000 uses 9999 safely).
RELAXATION_STAGE_5_DELTA=9999